{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@pages/*": ["pages/*"],
      "@fixture/*": ["fixture/*"],
      "@constants/*": ["constants/*"]
    }
  },
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
